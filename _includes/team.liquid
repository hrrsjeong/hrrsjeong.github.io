        >
      </div>
      <div>
        <h3 class="team-member-name">
          <a href="{{ '/people/rina-lee/' | prepend: language_prefix | relative_url }}">{% if language == 'ko' %}이리나{% else %}Rina Lee{% endif %}</a>
        </h3>
        <p class="team-member-role">Ph.D. Student</p>
        <p class="team-member-note">Co-advised, Seoul National University</p>
      </div>
    </article>

    <article class="team-member">
      <div class="team-member-media">
        <img
          src="{{ '/assets/img/people/jeongwoo-seo-portrait.jpg' | relative_url }}"
          alt="Jeongwoo Seo"
          loading="lazy"
        >
      </div>
      <div>
        <h3 class="team-member-name">
          <a href="{{ '/people/jeongwoo-seo/' | prepend: language_prefix | relative_url }}">{% if language == 'ko' %}서정우{% else %}Jeongwoo Seo{% endif %}</a>
