<section class="team-alumni-section" aria-labelledby="alumni-title">
  <div class="team-section-header">
    <h2 class="team-section-title" id="alumni-title">Alumni</h2>
  </div>
  {% for group in site.data.alumni %}
    {% if group.members.size > 0 %}
      <section class="team-alumni-group" aria-labelledby="alumni-{{ group.id }}-title">
        <h3 class="team-alumni-group-title" id="alumni-{{ group.id }}-title">{{ group.title }}</h3>
        <ul class="team-alumni-list">
          {% for member in group.members %}
            <li><a href="{{ member.url | prepend: language_prefix | relative_url }}">{% if language == 'ko' and member.name_ko %}{{ member.name_ko }}{% else %}{{ member.name }}{% endif %}</a></li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}
  {% endfor %}
</section>
