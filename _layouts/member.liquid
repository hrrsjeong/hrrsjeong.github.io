---
layout: page
---
{% include locale.liquid %}
{% assign member = page %}
{% if page.translation_of %}
  {% assign member = site.pages | where: 'url', page.translation_of | first %}
{% endif %}
{% assign member_ui = site.data.locales.en %}
<style>
  .member-profile {
    display: grid;
    grid-template-columns: minmax(10rem, 13.5rem) 1fr;
    gap: clamp(1.6rem, 5vw, 3.5rem);
    align-items: start;
    border-top: 1px solid var(--global-divider-color);
    border-bottom: 1px solid var(--global-divider-color);
    padding: clamp(1.4rem, 4vw, 2.4rem) 0;
  }
  .member-profile-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .member-profile-media img {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    width: 100%;
  }
  .member-profile-initials {
    align-items: center;
    background: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 0.35rem;
    color: var(--global-theme-color);
    display: flex;
    font-size: 1.45rem;
    font-weight: 720;
    height: 100%;
    justify-content: center;
    letter-spacing: 0.08em;
    width: 100%;
  }
  .member-profile-affiliation {
    color: var(--global-text-color);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0;
  }
  .member-profile-details {
    display: grid;
    gap: 1.45rem;
    margin-top: 1.65rem;
  }
  .member-profile-section h2 {
    color: var(--global-theme-color);
    font-size: 0.75rem;
    font-weight: 720;
    letter-spacing: 0.1em;
    margin: 0 0 0.7rem;
    text-transform: uppercase;
  }
  .member-profile-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .member-profile-entry + .member-profile-entry {
    margin-top: 0.85rem;
  }
  .member-profile-entry-title {
    color: var(--global-text-color);
    font-size: 0.96rem;
    font-weight: 630;
    line-height: 1.45;
    margin: 0 0 0.1rem;
  }
  .member-profile-entry-institution {
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    line-height: 1.45;
    margin: 0;
  }
  .member-profile-back {
    color: var(--global-theme-color);
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 650;
    margin-top: 1.75rem;
  }
  @media (max-width: 640px) {
    .member-profile {
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }
    .member-profile-media {
      max-width: 13.5rem;
    }
  }
</style>

<div class="member-profile">
  <div class="member-profile-media">
    {% if member.profile_image %}
      <img src="{{ member.profile_image | relative_url }}" alt="{{ member.title }}">
    {% else %}
      <div class="member-profile-initials" aria-hidden="true">{{ member.initials }}</div>
    {% endif %}
  </div>
  <div>
    <p class="member-profile-affiliation">
      Jeong Lab<br>
      {{ member_ui.affiliation_department -}}
      <br>
      {{ member_ui.affiliation_institution }}
    </p>

    {% if member.education or member.previous_positions %}
      <div class="member-profile-details">
        {% if member.education %}
          <section class="member-profile-section" aria-labelledby="member-education-title">
            <h2 id="member-education-title">{{ member_ui.education }}</h2>
            <ul class="member-profile-list">
              {% for item in member.education %}
                <li class="member-profile-entry">
                  <p class="member-profile-entry-title">{{ item.degree }}</p>
                  <p class="member-profile-entry-institution">{{ item.institution }}</p>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        {% if member.previous_positions %}
          <section class="member-profile-section" aria-labelledby="member-positions-title">
            <h2 id="member-positions-title">{{ member_ui.previous_positions }}</h2>
            <ul class="member-profile-list">
              {% for item in member.previous_positions %}
                <li class="member-profile-entry">
                  <p class="member-profile-entry-title">{{ item.title }}</p>
                  <p class="member-profile-entry-institution">{{ item.institution }}</p>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      </div>
    {% endif %}

    <a class="member-profile-back" href="{{ '/people/' | prepend: language_prefix | relative_url }}">{{ member_ui.back_to_team }}</a>
  </div>
</div>
