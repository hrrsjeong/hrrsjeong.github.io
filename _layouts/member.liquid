---
layout: page
---

<style>
  .member-profile {
    display: grid;
    grid-template-columns: minmax(10rem, 13.5rem) 1fr;
    gap: clamp(1.6rem, 5vw, 3.5rem);
    align-items: start;
    border-top: 1px solid var(--global-divider-color);
    border-bottom: 1px solid var(--global-divider-color);
    padding: clamp(1.4rem, 4vw, 2.4rem) 0;
  }
  .member-profile-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .member-profile-media img {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    width: 100%;
  }
  .member-profile-initials {
    align-items: center;
    background: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 0.35rem;
    color: var(--global-theme-color);
    display: flex;
    font-size: 1.45rem;
    font-weight: 720;
    height: 100%;
    justify-content: center;
    letter-spacing: 0.08em;
    width: 100%;
  }
  .member-profile-affiliation {
    color: var(--global-text-color);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0;
  }
  .member-profile-back {
    color: var(--global-theme-color);
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 650;
    margin-top: 1.5rem;
  }
  @media (max-width: 560px) {
    .member-profile {
      grid-template-columns: minmax(8.5rem, 45%) 1fr;
      gap: 1.2rem;
    }
  }
</style>

<div class="member-profile">
  <div class="member-profile-media">
    {% if page.profile_image %}
      <img src="{{ page.profile_image | relative_url }}" alt="{{ page.title }}">
    {% else %}
      <div class="member-profile-initials" aria-hidden="true">{{ page.initials }}</div>
    {% endif %}
  </div>
  <div>
    <p class="member-profile-affiliation">
      Jeong Lab<br>
      Department of Life Sciences<br>
      Gwangju Institute of Science and Technology (GIST)
    </p>
    <a class="member-profile-back" href="{{ '/people/' | relative_url }}">← Back to Team</a>
  </div>
</div>
