---
layout: default
---
{% include page_styles.liquid %}

<div
  class="post"
  {% if page.content_lang %}
    lang="{{ page.content_lang }}"
  {% endif %}
>
  <header class="post-header">
    <h1 class="post-title">{{ page.display_title | default: page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>
      {% if page.lang == 'ko' %}참고문헌{% else %}References{% endif %}
    </h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
